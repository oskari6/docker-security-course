FROM golang:1.16-alpine AS builder-stage
WORKDIR /app

RUN adduser -D appuser && chown appuser:appuser /app
COPY --chown=appuser:appuser code/example-backend .
USER appuser

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o server

FROM scratch

WORKDIR /app

COPY --from=builder-stage /app/server ./server

ENV REQUEST_ORIGIN=http://localhost:5001
USER 1000:1000

EXPOSE 8080
CMD ["./server"]
